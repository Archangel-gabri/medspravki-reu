@page "/students/{id:guid}"
@model ReuMedCertificates.Web.Pages.Students.DetailsModel
@{
    ViewData["Title"] = "Карточка студента";
    var s = Model.Student;
}

<div class="page-head">
    <div>
        <h1>@s.FullName</h1>
        <p>@s.Department · @s.Course курс · группа @s.Group</p>
    </div>
    <div class="head-actions">
        <a class="btn" href="/registry">← К реестру</a>
        <a class="btn" href="/students/@s.Id/scans">Сканы и справки</a>
        <a class="btn btn-primary" href="/students/@s.Id/certificates/new">+ Добавить справку</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-error">@Model.ErrorMessage</div> }

<div class="cards">
    <div class="card">
        <h2>Данные студента</h2>
        <dl class="kv">
            <dt>ФИО</dt><dd>@s.FullName</dd>
            <dt>Подразделение</dt><dd>@s.Department</dd>
            <dt>Курс</dt><dd>@s.Course</dd>
            <dt>Группа</dt><dd>@s.Group</dd>
            <dt>Преподаватель</dt><dd>@(s.Teacher ?? "—")</dd>
        </dl>
        <p class="note">Группа здоровья и ограничения хранятся в справке (ниже), а не в общем профиле — это минимизация медданных (152-ФЗ).</p>
    </div>

    <div class="card">
        <h2>Текущая справка</h2>
        @if (s.Current.Count == 0)
        {
            <div class="empty">Действующей справки нет. <a href="/students/@s.Id/certificates/new">Добавить</a>.</div>
        }
        else
        {
            foreach (var c in s.Current)
            {
                var cls = c.Admitted ? StatusDisplay.CertClass(c.Status) : "danger";
                <div class="row-status @cls" style="border-left-width:4px; padding-left:12px; margin-bottom:14px">
                    @if (!c.Admitted)
                    {
                        <span class="badge danger"><span class="dot"></span>Не допущен</span>
                        <span class="badge @StatusDisplay.CertClass(c.Status)" style="margin-left:6px"><span class="dot"></span>@StatusDisplay.CertText(c.Status)</span>
                    }
                    else
                    {
                        <span class="badge @cls"><span class="dot"></span>@StatusDisplay.CertText(c.Status)</span>
                    }
                    <dl class="kv" style="margin-top:10px">
                        <dt>Тип</dt><dd>@StatusDisplay.CertType(c.Type)</dd>
                        <dt>Допуск</dt><dd>@(c.Admitted ? "Допущен" : "НЕ допущен (по справке)")</dd>
                        <dt>Срок действия</dt><dd>@(c.Admitted ? $"{c.StartDate:dd.MM.yyyy} – {c.EndDate:dd.MM.yyyy}" : "—")</dd>
                        <dt>Группа здоровья</dt><dd>@if (c.HealthGroup == HealthGroup.Unknown) { <text>не указана</text> } else { <strong>@StatusDisplay.HealthGroup(c.HealthGroup)</strong> <text>группа</text> }</dd>
                        @if (c.PhysicalGroup != PhysicalEducationGroup.None)
                        {
                            <dt>Физкультурная группа</dt><dd>@StatusDisplay.PhysicalGroup(c.PhysicalGroup)</dd>
                        }
                        <dt>Ограничения</dt><dd>@(string.IsNullOrWhiteSpace(c.Restrictions) ? "—" : c.Restrictions)</dd>
                        <dt>Справка №</dt><dd>@(c.CertificateNumber ?? "—")</dd>
                        <dt>Мед. организация</dt><dd>@(c.MedicalOrganization ?? "—")</dd>
                        <dt>Проверка</dt><dd><span class="pill">@StatusDisplay.Verification(c.VerificationStatus)</span></dd>
                    </dl>
                    <div style="margin-top:10px">
                        <a class="btn btn-sm btn-primary" href="/students/@s.Id/certificates/@c.Id/edit">Изменить / поправить</a>
                    </div>
                    @if (c.VerificationStatus == VerificationStatus.Verified)
                    {
                        <form method="post" asp-page-handler="Revoke" style="margin-top:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap">
                            <input type="hidden" name="certificateId" value="@c.Id" />
                            <input class="input" name="reason" placeholder="Причина отзыва допуска" style="flex:1; min-width:200px" required />
                            <button type="submit" class="btn btn-sm btn-danger">Отозвать допуск</button>
                        </form>
                    }
                </div>
            }
        }

        @if (s.History.Count > 0)
        {
            <h2 style="margin-top:18px">История справок</h2>
            <div class="table-wrap">
                <table class="grid">
                    <thead><tr><th>Срок</th><th>Физ. группа</th><th>Ограничения</th><th>Статус</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in s.History)
                    {
                        var cls = StatusDisplay.CertClass(c.Status);
                        <tr class="row-status @cls">
                            <td class="dim">@(c.Admitted ? $"{c.StartDate:dd.MM.yyyy} – {c.EndDate:dd.MM.yyyy}" : "—")</td>
                            <td>@StatusDisplay.PhysicalGroup(c.PhysicalGroup)</td>
                            <td class="dim">@(string.IsNullOrWhiteSpace(c.Restrictions) ? "—" : c.Restrictions)</td>
                            <td><span class="badge @cls"><span class="dot"></span>@StatusDisplay.CertText(c.Status)</span></td>
                            <td><a class="btn btn-sm" href="/students/@s.Id/certificates/@c.Id/edit">Изменить</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
