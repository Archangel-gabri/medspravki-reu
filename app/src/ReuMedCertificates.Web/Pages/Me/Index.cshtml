@page "/me"
@model ReuMedCertificates.Web.Pages.Me.IndexModel
@{
    ViewData["Title"] = "Моя справка";
    var s = Model.Student;
}

<div class="page-head">
    <div>
        <h1>Моя справка</h1>
        @if (s is not null)
        {
            <p>@s.FullName · @s.Department · @s.Course курс · группа @s.Group</p>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-warn">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-error">@Model.ErrorMessage</div> }

@if (Model.NotLinked || s is null)
{
    <div class="card">
        <div class="empty">
            Ваш аккаунт пока не привязан к карточке студента. Обратитесь к преподавателю
            физической культуры или в деканат — они свяжут учётную запись с вашими данными.
        </div>
    </div>
}
else
{
    <div class="cards">
        <div class="card">
            <h2>Текущий допуск</h2>
            @if (s.Current.Count == 0)
            {
                <div class="empty">
                    Действующей медицинской справки нет. Принесите справку (форма 086/у)
                    преподавателю физической культуры — он внесёт её в систему.
                </div>
            }
            else
            {
                foreach (var c in s.Current)
                {
                    var cls = StatusDisplay.CertClass(c.Status);
                    <div class="row-status @cls" style="border-left-width:4px; padding-left:12px; margin-bottom:14px">
                        <span class="badge @cls"><span class="dot"></span>@StatusDisplay.CertText(c.Status)</span>
                        <dl class="kv" style="margin-top:10px">
                            <dt>Срок действия</dt><dd>@c.StartDate.ToString("dd.MM.yyyy") – @c.EndDate.ToString("dd.MM.yyyy")</dd>
                            <dt>Физкультурная группа</dt><dd>@StatusDisplay.PhysicalGroup(c.PhysicalGroup)</dd>
                            <dt>Ограничения</dt><dd>@(string.IsNullOrWhiteSpace(c.Restrictions) ? "—" : c.Restrictions)</dd>
                            <dt>Справка №</dt><dd>@(c.CertificateNumber ?? "—")</dd>
                            <dt>Мед. организация</dt><dd>@(c.MedicalOrganization ?? "—")</dd>
                            <dt>Статус проверки</dt><dd><span class="pill">@StatusDisplay.Verification(c.VerificationStatus)</span></dd>
                        </dl>
                    </div>
                }
            }
            <p class="note">Если данные неверны — сообщите преподавателю физической культуры. Изменения вносит только сотрудник кафедры.</p>
        </div>

        @if (s.History.Count > 0)
        {
            <div class="card">
                <h2>История справок</h2>
                <div class="table-wrap">
                    <table class="grid">
                        <thead><tr><th>Срок</th><th>Физ. группа</th><th>Ограничения</th><th>Статус</th></tr></thead>
                        <tbody>
                        @foreach (var c in s.History)
                        {
                            var cls = StatusDisplay.CertClass(c.Status);
                            <tr class="row-status @cls">
                                <td class="dim">@c.StartDate.ToString("dd.MM.yyyy") – @c.EndDate.ToString("dd.MM.yyyy")</td>
                                <td>@StatusDisplay.PhysicalGroup(c.PhysicalGroup)</td>
                                <td class="dim">@(string.IsNullOrWhiteSpace(c.Restrictions) ? "—" : c.Restrictions)</td>
                                <td><span class="badge @cls"><span class="dot"></span>@StatusDisplay.CertText(c.Status)</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="cards">
        <div class="card">
            <h2>Загрузить справку на проверку</h2>
            <p>Сфотографируйте или отсканируйте медицинскую справку (форма 086/у) — PDF, JPG или PNG, до @Model.MaxUploadMb МБ. Её проверит медработник кафедры и оформит ваш допуск.</p>
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin:10px 0">
                    <input class="input" type="file" name="file" accept="application/pdf,image/jpeg,image/png" required />
                    <button type="submit" class="btn btn-primary">Отправить на проверку</button>
                </div>
                <label style="display:flex; gap:8px; align-items:flex-start; cursor:pointer">
                    <input type="checkbox" name="consent" value="true" />
                    <span class="note" style="margin:0">Даю согласие на обработку моих медицинских данных (спецкатегория ПДн, 152-ФЗ) для допуска к занятиям физической культурой. Данные обрабатываются локально в РЭУ и во внешние сервисы не передаются.</span>
                </label>
            </form>
        </div>

        <div class="card">
            <h2>Мои заявки</h2>
            @if (Model.MyScans.Count == 0)
            {
                <div class="empty">Вы пока не загружали справок.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="grid">
                        <thead><tr><th>Файл</th><th>Загружена</th><th>Статус</th></tr></thead>
                        <tbody>
                        @foreach (var sc in Model.MyScans)
                        {
                            var processed = sc.CertificateId is not null;
                            <tr>
                                <td>@sc.OriginalFileName</td>
                                <td class="dim">@sc.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="pill">@(processed ? "Обработана" : "На проверке")</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="note">Медицинское содержимое справки видит только медработник кафедры. Результат проверки появляется в карточке допуска выше.</p>
            }
        </div>
    </div>
}
