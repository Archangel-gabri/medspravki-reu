@page "/me"
@model ReuMedCertificates.Web.Pages.Me.IndexModel
@{
    ViewData["Title"] = "Справки";
    var s = Model.Student;
    var today = DateOnly.FromDateTime(DateTime.Today);
}
@functions {
    // Допуск по сроку справки (строгий вид: серые точки, красный только для проблем).
    static (string text, string cls) Dopusk(DateOnly? start, DateOnly? end, bool rejected, DateOnly today)
    {
        if (rejected) return ("—", "muted");
        if (start is null || end is null) return ("—", "muted");
        if (end < today) return ("Истекла", "danger");
        if (start > today) return ("Будет активна", "muted");
        if (end.Value.DayNumber - today.DayNumber <= 14) return ("Истекает", "warn");
        return ("Действует", "ok");
    }
}

<div class="page-head">
    <div>
        <h1>Справки</h1>
        <p>Загрузите медицинскую справку — она уйдёт на проверку преподавателю вашей группы.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-error">@Model.ErrorMessage</div> }
@if (Model.MyScans.Count > 0 && Model.MyScans[0].RejectionReason is not null)
{
    <div class="alert alert-warn">Последняя заявка отклонена: «@Model.MyScans[0].RejectionReason». Исправьте замечание и отправьте справку заново.</div>
}

@if (Model.NotLinked || s is null)
{
    <div class="card">
        <div class="empty">
            Ваш аккаунт пока не привязан к карточке студента. Обратитесь к преподавателю
            физической культуры или в деканат — они свяжут учётную запись с вашими данными.
        </div>
    </div>
}
else
{
    <div class="cards">
        <div class="card">
            <h2>Профиль</h2>
            <dl class="kv">
                <dt>ФИО</dt><dd>@s.FullName</dd>
                <dt>Подразделение</dt><dd>@s.Department</dd>
                <dt>Курс</dt><dd>@s.Course</dd>
                <dt>Группа</dt><dd>@s.Group</dd>
                <dt>Ваш преподаватель</dt><dd>@(s.Teacher ?? "—")</dd>
            </dl>
            <p class="note">Справка отправляется только преподавателю вашей группы.</p>
        </div>

        <div class="card">
            <h2>Отправить справку</h2>
            <form id="upform" method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                <label class="fld">
                    <span>Файл справки (PDF, JPG, PNG)</span>
                    <input id="upfile" class="input" type="file" name="file" accept="application/pdf,image/jpeg,image/png" required />
                </label>
                <button type="submit" id="upbtn" class="btn btn-primary" style="margin-top:14px">Отправить на проверку</button>
                <p class="note">Срок действия, группу здоровья, тип справки и наличие печати/подписи распознаёт ИИ — вводить вручную ничего не нужно. Финальное решение принимает преподаватель. Отправляя файл, вы даёте согласие на обработку медицинских данных (152-ФЗ) в периметре РЭУ.</p>
            </form>
            <script>
                (function () {
                    var f = document.getElementById('upform');
                    if (!f) return;
                    var b = document.getElementById('upbtn'), fi = document.getElementById('upfile');
                    f.addEventListener('submit', function () { b.disabled = true; b.textContent = 'Отправляем…'; });
                    fi.addEventListener('change', function () { b.disabled = false; b.textContent = 'Отправить на проверку'; });
                })();
            </script>
        </div>
    </div>

    <div class="card" style="margin-top:16px">
        <h2>Мои справки</h2>
        @if (Model.MyScans.Count == 0)
        {
            <div class="empty">Вы пока не отправляли справок.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="grid" style="min-width:0">
                    <thead><tr><th>Отправлена</th><th>Срок</th><th>Статус проверки</th><th>Допуск</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var sc in Model.MyScans)
                    {
                        var rejected = sc.RejectionReason is not null;
                        var verified = sc.CertificateId is not null;
                        var st = sc.CertStartDate ?? sc.ProposedStartDate;
                        var en = sc.CertEndDate ?? sc.ProposedEndDate;
                        var (dText, dCls) = Dopusk(st, en, rejected, today);
                        <tr>
                            <td class="dim">@sc.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(st.HasValue && en.HasValue ? $"{st:dd.MM.yyyy} – {en:dd.MM.yyyy}" : "—")</td>
                            <td>
                                @if (rejected)
                                {
                                    <span class="pill" style="color:#a94442; background:#f9eeee; border-color:#ebccd1" title="@sc.RejectionReason">Отклонено</span>
                                }
                                else if (verified)
                                {
                                    <span class="pill">Проверено</span>
                                }
                                else
                                {
                                    <span class="pill">На проверке</span>
                                }
                            </td>
                            <td><span class="badge @dCls"><span class="dot"></span>@dText</span></td>
                            <td><a class="btn btn-sm" href="/me/scans/@sc.Id/file" target="_blank">Мой файл</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
