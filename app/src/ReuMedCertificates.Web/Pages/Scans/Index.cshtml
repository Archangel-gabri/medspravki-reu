@page "/students/{id:guid}/scans"
@model ReuMedCertificates.Web.Pages.Scans.IndexModel
@{
    ViewData["Title"] = "Сканы справки";
}
@functions {
    static string RecStatus(string s) => s switch
    {
        "Processing" => "ИИ проверяет…",
        "AutoApproved" => "ИИ: допуск выдан автоматически",
        "Rejected" => "Отклонено ИИ",
        "NeedsReview" => "Нужна ручная проверка",
        "Done" => "ИИ распознал",
        "Failed" => "Ошибка распознавания",
        "Skipped" => "ИИ не смог распознать",
        _ => "Не распознавалось"
    };
}

<div class="page-head">
    <div>
        <h1>Сканы и распознавание</h1>
        <p>Студент: <strong>@Model.StudentName</strong></p>
    </div>
    <div class="head-actions"><a class="btn" href="/students/@Model.StudentId">← К карточке</a></div>
</div>

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-warn">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-error">@Model.ErrorMessage</div> }

<div class="card" style="max-width:920px; margin-bottom:16px">
    <h2>Загрузить справку (PDF / JPG / PNG, до @Model.MaxUploadMb МБ)</h2>
    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
            <input class="input" type="file" name="file" accept="application/pdf,image/jpeg,image/png" required />
            <button type="submit" class="btn btn-primary">Загрузить</button>
        </div>
        <p class="note">Файл хранится вне публичной папки; в БД — путь, размер и SHA-256 (контроль подмены). Диагноз в систему не вносится.</p>
    </form>
</div>

@if (Model.Scans.Count == 0)
{
    <div class="card empty">Сканов пока нет.</div>
}
else
{
    foreach (var row in Model.Scans)
    {
        <div class="card" style="max-width:920px; margin-bottom:14px">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px">
                <div>
                    <strong>@row.Item.OriginalFileName</strong>
                    <span class="dim"> · @((row.Item.SizeBytes / 1024.0).ToString("0")) КБ · @row.Item.UploadedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    <div><span class="pill">@RecStatus(row.Item.RecognitionStatus)</span></div>
                    @if (!string.IsNullOrWhiteSpace(row.Item.AiNotes))
                    {
                        <div class="note" style="margin-top:4px">@row.Item.AiNotes</div>
                    }
                </div>
                <div style="display:flex; gap:8px">
                    <a class="btn btn-sm" href="/scans/@row.Item.Id/file" target="_blank">Открыть</a>
                    @if (Model.AiEnabled)
                    {
                        <form method="post" asp-page-handler="Recognize" style="margin:0">
                            <input type="hidden" name="scanId" value="@row.Item.Id" />
                            <button type="submit" class="btn btn-sm btn-primary">Распознать ИИ</button>
                        </form>
                        <a class="btn btn-sm" href="/students/@Model.StudentId/scans/@row.Item.Id/zoom">Зум по полям</a>
                    }
                </div>
            </div>

            @if (row.Fields.Count > 0)
            {
                <div class="table-wrap" style="margin-top:12px">
                    <table class="grid">
                        <thead><tr><th>Поле (ИИ)</th><th>Значение</th></tr></thead>
                        <tbody>
                        @foreach (var f in row.Fields)
                        {
                            <tr><td class="dim">@f.Name</td><td>@(string.IsNullOrWhiteSpace(f.Value) ? "—" : f.Value)</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="note">⚠ Это черновик ИИ-предзаполнения, НЕ источник истины. Проверьте и подтвердите каждое поле.</p>
            }

            @if (row.Item.CertificateId is not null)
            {
                <p class="note" style="margin-top:12px">✓ По этому скану справка уже создана и подтверждена.</p>
            }
            else if (row.Item.RejectionReason is not null)
            {
                <p class="alert alert-warn" style="margin-top:12px">✗ Заявка отклонена: @row.Item.RejectionReason</p>
            }
            else
            {
                <details style="margin-top:12px">
                    <summary style="cursor:pointer; color:#1F5BA8; font-weight:600">Создать справку из этого скана</summary>
                    <form method="post" asp-page-handler="CreateCert" style="margin-top:10px">
                        <input type="hidden" name="scanId" value="@row.Item.Id" />
                        <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px">
                            <label>Дата начала<input class="input" type="date" name="startDate" required /></label>
                            <label>Дата окончания<input class="input" type="date" name="endDate" required /></label>
                            <label>Дата выдачи<input class="input" type="date" name="issueDate" /></label>
                            <label>Справка №<input class="input" name="certificateNumber" /></label>
                            <label>Тип справки
                                <select class="input" name="type">
                                    @foreach (var t in Enum.GetValues<CertificateType>())
                                    {
                                        <option value="@t">@StatusDisplay.CertType(t)</option>
                                    }
                                </select>
                            </label>
                            <label>Физкультурная группа
                                <select class="input" name="physicalGroup">
                                    @foreach (var pg in Enum.GetValues<PhysicalEducationGroup>())
                                    {
                                        <option value="@pg">@StatusDisplay.PhysicalGroup(pg)</option>
                                    }
                                </select>
                            </label>
                            <label>Группа здоровья
                                <select class="input" name="healthGroup">
                                    @foreach (var hg in Enum.GetValues<HealthGroup>())
                                    {
                                        <option value="@hg">@StatusDisplay.HealthGroup(hg)</option>
                                    }
                                </select>
                            </label>
                            <label>Мед. организация<input class="input" name="medicalOrganization" /></label>
                        </div>
                        <label style="display:block; margin-top:8px">Ограничения<textarea class="input" name="restrictions" rows="2"></textarea></label>
                        <button type="submit" class="btn btn-primary" style="margin-top:10px">Создать и подтвердить справку</button>
                        <p class="note">Поля вносит и подтверждает медработник — ИИ лишь подсказывает. После создания справка сразу становится действующим допуском студента.</p>
                    </form>
                </details>
                <form method="post" asp-page-handler="RejectScan" style="margin-top:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap">
                    <input type="hidden" name="scanId" value="@row.Item.Id" />
                    <input class="input" name="reason" placeholder="Причина отклонения (увидит студент)" style="flex:1; min-width:220px" required />
                    <button type="submit" class="btn btn-sm btn-danger">Отклонить заявку</button>
                </form>
            }
        </div>
    }
}

@if (!Model.AiEnabled)
{
    <p class="note">ИИ-распознавание выключено (Recognition:Provider = Manual). Включается локальным провайдером (Ollama/VLM) в конфигурации — без внешних облаков.</p>
}
else
{
    <p class="note">ИИ-провайдер: локальный (@Model.AiModel). Обработка в периметре — медданные не уходят во внешние сервисы.</p>
}
