@page "/Error"
@model ReuMedCertificates.Web.Pages.ErrorModel
@{
    Layout = null;
    ViewData["Title"] = "Ошибка";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Ошибка</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="auth-bg">
    <div class="auth-card" style="text-align:center">
        <h1>Что-то пошло не так</h1>
        <p class="sub">@(Model.StatusCode is { } c ? $"Код: {c}" : "Произошла внутренняя ошибка.")</p>
        <a class="btn btn-primary" href="/registry">На главную</a>
    </div>
</div>
</body>
</html>
